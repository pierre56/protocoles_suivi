{
  "genre":"F",
  "label": "Aire",
  "label_list": "Aires",
  "map_label_field_name": "base_site_name",
  "export_pdf": [
    {
      "template": "fiche_secteur.html",
      "label": "Export PDF"
    }
  ],
  "display_properties": [
    "id_inventor",
    "sites_group_name",
    "sites_group_code",
    "commune",
    "sites_group_description", 
    "comments"
  ],
  "display_list": [
    "sites_group_name",
    "nb_sites"
  ],
  "specific": {
    "id_inventor": {
      "type_widget": "datalist",
      "attribut_label": "Descripteur de l'aire",
      "api": "users/menu/__MODULE.ID_LIST_OBSERVER",
      "application": "GeoNature",
      "keyValue": "id_role",
      "keyLabel": "nom_complet",
      "type_util": "user",
      "required": true
    },
    "sites_group_name": {
      "type_widget": "text",
      "attribut_label": "Nom de l'aire",
      "required": true,
      "value": "35_NomCommune_NomAire (exemple a modifier)",
      "hidden": false
    },
    "sites_group_code": {
      "type_widget": "text",
      "attribut_label": "Code terrain (facultatif)",
      "required": false,
      "hidden": false
    },
    "commune": {
      "type_widget": "municipalities",
      "attribut_label": "Commune (facultatif)" ,
      "value_field_name": "id_area",
      "type_util": "area",
      "required": false,
      "definition": "Veuillez saisir la ou les communes concernées par l'aire"    
    },
    "sites_group_description": {
      "type_widget": "textarea",
      "attribut_label": "Description",
      "required": false,
      "hidden":false,
      "definition": "Veuillez saisir les informations pertinentes sur l'aire'"
    },
    "comments": {
      "type_widget": "textarea",
      "attribut_label": "Commentaire"
    },
    "nb_visits": {
      "attribut_label": "Nombre de passages"
    },
    "nb_sites": {
      "attribut_label": "Nombre de transects"
    },
    
    "medias": {
      "type_widget": "medias",
      "attribut_label": "Médias",
      "schema_dot_table": "gn_monitoring.t_sites_groups"
    }

  },
  "change": [
  "({objForm, meta}) => {",
  "console.log('test meta');", 
  "console.log(meta);",   
  "console.log('test objForm');", 
  "console.log(objForm);",   
  "}"
]

}
